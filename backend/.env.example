# Criar este .env no backend somente se utilizar o projeto isolado, sem o Docker.

PORT=3000
MQTT_BROKER=mqtt://localhost:1883
MQTT_TELEMETRY_TOPIC=horta/telemetry
MQTT_IRRIGATION_TOPIC=horta/irrigation
MONGO_URI=mongodb://localhost:27017/horta-comunitaria

# Chave usada para assinar os tokens de sessão. Use uma chave diferente
# em cada ambiente e nunca compartilhe a chave real.

JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Dados usados somente para criar o primeiro administrador.
# Depois que a conta for criada, altere os dados pelo painel web.
ADMIN_NAME=Administrador Inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-por-uma-forte