# Configuração usada pelo Docker Compose.
# Copie este arquivo para .env antes de iniciar os containers:
# copy .env.example .env

# Chave usada para assinar os tokens de sessão. Use uma chave diferente
# em cada ambiente e nunca compartilhe a chave real.
JWT_SECRET=dev-horta-comunitaria-chave-troque-por-uma-chave-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h

# Dados usados somente para criar o primeiro administrador.
# Depois que a conta for criada, altere os dados pelo painel web.
ADMIN_NAME=Administrador Inicial
ADMIN_EMAIL=admin@horta.local
ADMIN_PASSWORD=troque-esta-senha-por-uma-senha-com-no-minimo-12-caracteres